[Unit]
Description=Scrying Stone Prop Launcher
After=network.target
Wants=netheril-kiosk.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/benthebuilder/knoxrpg-netheril-prop
ExecStart=/usr/bin/node launcher/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
